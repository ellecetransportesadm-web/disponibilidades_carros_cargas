            const placaForm = document.getElementById('formPlaca').value.toUpperCase().trim();
            
            const payload = {
                acao: "salvar", data: dataAtual,
                depositante: document.getElementById('formDepositante').value.toUpperCase(),
                cliente: document.getElementById('formCliente').value.toUpperCase(),
                origem: document.getElementById('formOrigem').value.toUpperCase(),
