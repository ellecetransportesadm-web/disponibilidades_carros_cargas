        function validarRestricoesFormulario() {
            const monitor = document.getElementById('monitorStatus');
            const botao = document.getElementById('btnTransmitir');
            
            const placa = document.getElementById('formPlaca').value.toUpperCase().trim();
            const dtAtual = document.getElementById('formDt').value.toUpperCase().trim();
            const agendamentoForm = document.getElementById('formAgendamento').value;
            const peso = parseFloat(document.getElementById('formPeso').value) || 0;
            const m3 = parseFloat(document.getElementById('formM3').value) || 0;
            
            const tipoCarga = document.getElementById('formTipoCarga').value;
            const palletsDigitados = parseFloat(document.getElementById('formPallets').value) || 0;

            if (placa && bloqueiosManuais[placa]) {
                monitor.className = "status-display status-warning";
                monitor.innerText = `BLOQUEIO MANUAL: ESTE CARRO ESTÁ INDISPONÍVEL POR MOTIVO DE (${bloqueiosManuais[placa]}).`;
                botao.disabled = true; botao.classList.add("btn-bloqueado"); botao.innerText = "BLOQUEADO: OPERAÇÃO RESTRITA";
                return;
            }

            if (limitePesoCaminhao > 0 || limiteM3Caminhao > 0) {
                if (peso > limitePesoCaminhao || m3 > limiteM3Caminhao) {
                    monitor.className = "status-display status-danger";
                    monitor.innerText = "VEÍCULO NÃO SUPORTA ESSA CARGA! LIMITE DE CAPACIDADE EXCEDIDO.";
                    botao.disabled = true; botao.classList.add("btn-bloqueado"); botao.innerText = "BLOQUEADO: EXCESSO DE CARGA";
                    return;
                }
            }

            if (tipoCarga === "PALETIZADA" && placa) {
                if (palletsDigitados > limitePalletsCaminhao) {
                    monitor.className = "status-display status-danger";
                    monitor.innerText = `VEÍCULO NÃO SUPORTA! DIGITADO: ${palletsDigitados} PL / LIMITE DA PLACA: ${limitePalletsCaminhao} PL.`;
                    botao.disabled = true; botao.classList.add("btn-bloqueado"); botao.innerText = "BLOQUEADO: EXCESSO DE PALLETS";
                    return;
                }
            }

            if (placa && agendamentoForm) {
                const tempoForm = new Date(agendamentoForm).getTime();
                const JANELA_PROIBIDA_MS = 4 * 60 * 60 * 1000;
                const DOZE_HORAS_MS = 12 * 60 * 60 * 1000;
                const agora = new Date().getTime();

                const conflito = cacheProgramacoes.find(p => {
                    if (modoEdicao && p.dt.toUpperCase().trim() === dtAtual) return false;
                    if (p.placa.toUpperCase().trim() === placa && p.agendamento) {
                        const tempoExistente = new Date(p.agendamento).getTime();
                        
                        if (liberacoesForçadas.includes(placa)) return false;
                        if ((agora - tempoExistente) > DOZE_HORAS_MS) return false;

                        return Math.abs(tempoForm - tempoExistente) < JANELA_PROIBIDA_MS;
                    }
                    return false;
                });

                if (conflito) {
                    let horaConflito = formatarDataHoraBr(conflito.agendamento);
                    monitor.className = "status-display status-danger";
                    monitor.innerText = `BLOQUEIO: ESTE VEÍCULO JÁ TEM PROGRAMAÇÃO AGENDADA NESSE PERÍODO (${horaConflito}).`;
                    botao.disabled = true; botao.classList.add("btn-bloqueado"); botao.innerText = "BLOQUEADO: CONFLITO DE HORÁRIO";
                    return;
                }
            }

            if (placa) {
                monitor.className = "status-display"; 
                monitor.innerText = `VEÍCULO DISPONÍVEL E CAPACIDADE COMPATÍVEL`;
                botao.disabled = false; botao.classList.remove("btn-bloqueado"); 
                botao.innerText = modoEdicao ? "CONFIRMAR ALTERAÇÕES" : "GRAVAR PROGRAMAÇÃO";
            }
        }

        function salvarProgramacao() {
            const hoje = new Date();
