            };

            if(!payload.dt || !payload.depositante || !payload.placa) { alert("POR FAVOR, PREENCHA OS CAMPOS ESSENCIAIS (DT, DEPOSITANTE E PLACA)."); return; }

            fetch(URL_API, { method: "POST", mode: "no-cors", body: JSON.stringify(payload) })
            .then(() => {
                if(liberacoesForçadas.includes(placaForm)){
                    liberacoesForçadas = liberacoesForçadas.filter(item => item !== placaForm);
                    localStorage.setItem("nexus_liberacoes_forcadas", JSON.stringify(liberacoesForçadas));
                }
                alert("OPERAÇÃO REALIZADA COM SUCESSO!");
                cancelarEdicao(); 
                carregarDadosIniciais();
            });
        }

