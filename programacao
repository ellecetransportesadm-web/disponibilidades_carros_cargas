        }

        function cancelarEdicao() {
            modoEdicao = false; 
            document.getElementById('formTitulo').innerText = "PROGRAMAÇÃO ATIVA";
            document.getElementById('formDt').disabled = false; 
            document.getElementById('btnCancelarEdicao').style.display = "none";
            
            document.getElementById('formDt').value = ""; 
            document.getElementById('formDepositante').value = "";
            document.getElementById('formCliente').value = ""; 
            document.getElementById('formOrigem').value = "";
            document.getElementById('formDestino').value = ""; 
            document.getElementById('formVolume').value = "";
            document.getElementById('formPeso').value = ""; 
            document.getElementById('formM3').value = "";
            document.getElementById('formAgendamento').value = ""; 
            document.getElementById('formPlaca').value = "";
            document.getElementById('formTipoCarga').value = "BATIDA";
            document.getElementById('formPallets').value = "0";
            alternarEstadoCampoPallets();
        }

        function filtrarTabela() {
            const termo = document.getElementById('txtFiltro').value.toUpperCase().trim();
            const dataFiltroRaw = document.getElementById('filtroData').value;
            let dataFiltroFormato = "";
            
            if(dataFiltroRaw) {
                const partes = dataFiltroRaw.split("-");
                dataFiltroFormato = `${partes[2]}/${partes[1]}/${partes[0]}`;
            }

            cacheFiltradoAtual = cacheProgramacoes.filter(p => {
                const bateData = !dataFiltroFormato || p.data === dataFiltroFormato;
                const bateTermo = !termo || (
                    p.placa.toUpperCase().includes(termo) || 
                    p.cliente.toUpperCase().includes(termo) || 
                    p.dt.toUpperCase().includes(termo) || 
                    p.destino.toUpperCase().includes(termo)
                );
                return bateData && bateTermo;
            });
            atualizarTabela(cacheFiltradoAtual);
            renderizarFrota(); 
        }

        function atualizarTabela(lista) {
            const corpo = document.getElementById('corpoTabela');
            corpo.innerHTML = "";
            
            lista.forEach((p, index) => {
                let numeroReferencia = index + 1; 
                let exibeTipo = p.tipoCarga || "BATIDA";
                let exibePallets = (exibeTipo === "BATIDA") ? "BATIDA" : (p.qtdPallets || "0") + " PL";
                let horaAgendamento = formatarDataHoraBr(p.agendamento);

                corpo.innerHTML += `<tr>
                    <td><strong style="color:var(--neon-cyan);">#${numeroReferencia}</strong></td>
                    <td>${p.data}</td>
                    <td><strong>${horaAgendamento}</strong></td>
                    <td><strong>${p.dt.toUpperCase()}</strong></td>
                    <td>${p.cliente.toUpperCase()}</td>
                    <td>${p.placa.toUpperCase()}</td>
                    <td>${p.motorista.toUpperCase()}</td>
                    <td>${p.origem.toUpperCase()}</td>
                    <td>${p.destino.toUpperCase()}</td>
                    <td>${exibeTipo}</td>
                    <td><strong>${exibePallets}</strong></td>
                    <td>${p.peso}</td>
                    <td>${p.m3}</td>
                    <td>
                        <button class="btn-action btn-edit" onclick="prepararEdicao('${p.dt}')">EDITAR</button>
                        <button class="btn-action btn-del" onclick="excluirRegistro('${p.dt}')">EXCLUIR</button>
                    </td>
                </tr>`;
            });
        }

        function limparCamposAutomaticos() {
            document.getElementById('formMotorista').value = ""; 
            document.getElementById('formCpf').value = "";
            document.getElementById('formTelefone').value = ""; 
            document.getElementById('formTipo').value = "";
            limitePesoCaminhao = 0; 
            limiteM3Caminhao = 0;
            limitePalletsCaminhao = 0;
            const botao = document.getElementById('btnTransmitir');
            botao.disabled = false; 
            botao.classList.remove("btn-bloqueado");
            botao.innerText = modoEdicao ? "CONFIRMAR ALTERAÇÕES" : "GRAVAR PROGRAMAÇÃO";
            document.getElementById('monitorStatus').className = "status-display";
            document.getElementById('monitorStatus').innerText = "AGUARDANDO LEITURA DE PLACA...";
        }
    </script>
</body>
</html>
