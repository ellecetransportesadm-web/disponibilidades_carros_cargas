        function dispararImpressaoLote() {
            const deNum = parseInt(document.getElementById('printLoteDe').value);
            const ateNum = parseInt(document.getElementById('printLoteAte').value);

            if(isNaN(deNum) || isNaN(ateNum)) { alert("POR FAVOR, INFORME O INTERVALO SEQUENCIAL CORRETO (DE / ATÉ)."); return; }
            if(deNum > ateNum) { alert("O NÚMERO INICIAL NÃO PODE SER MAIOR QUE O NÚMERO FINAL."); return; }

            let htmlAcumulado = ""; let encontrados = 0;

            for (let i = deNum - 1; i < ateNum; i++) {
                if (cacheFiltradoAtual[i]) {
                    htmlAcumulado += construirHtmlBlocoOrdem(cacheFiltradoAtual[i]);
                    encontrados++;
                }
            }

            if(encontrados === 0) { alert("NENHUMA PROGRAMAÇÃO FOI ENCONTRADA NESSE INTERVALO DE REFERÊNCIA."); return; }
            document.getElementById('areaImpressaoOrdem').innerHTML = htmlAcumulado;
            window.print();
        }

