        // =====================================================================
        // FUNÇÃO CORRIGIDA: os contadores agora só somam veículos que passaram
        // no filtro de texto, garantindo que os indicadores de % sejam precisos.
        // =====================================================================
        function renderizarFrota() {
            const container = document.getElementById('listaFrota');
            container.innerHTML = "";
            const agora = new Date().getTime();
            const DOZE_HORAS_MS = 12 * 60 * 60 * 1000;

            const filtroTextoLista = document.getElementById('txtFiltroListaFrota').value.toUpperCase().trim();

            let contDisponivel = 0;
            let contProgramado = 0;
            let contRestrito = 0;

            cacheFrota.forEach(v => {
                const placaNorm = v.placa.toUpperCase().trim();
                const motoristaNorm = v.motorista.toUpperCase().trim();
                const opNorm = (v.operacao || "VENDA").toUpperCase().trim();

                // FILTRO PRIMEIRO: veículos que não batem são completamente ignorados
                if (filtroTextoLista && !placaNorm.includes(filtroTextoLista) && !motoristaNorm.includes(filtroTextoLista) && !opNorm.includes(filtroTextoLista)) {
                    return;
                }

                let statusReservado = false;
                let maisDeDozeHoras = false;
                let stringAgendamento = "";

                const progAtiva = cacheProgramacoes.find(p => p.placa.toUpperCase().trim() === placaNorm && p.agendamento);

                if (progAtiva) {
                    const tempoAgendado = new Date(progAtiva.agendamento).getTime();
                    stringAgendamento = formatarDataHoraBr(progAtiva.agendamento);
                    if ((agora - tempoAgendado) < DOZE_HORAS_MS) statusReservado = true;
                    else maisDeDozeHoras = true;
                }

                // CONTADORES: só chegam aqui veículos que passaram no filtro acima
                if (bloqueiosManuais[placaNorm]) contRestrito++;
                else if ((statusReservado || maisDeDozeHoras) && !liberacoesForçadas.includes(placaNorm)) contProgramado++;
                else contDisponivel++;

                let itemClass = "";
                let badgeHtml = "";

                if (bloqueiosManuais[placaNorm]) {
                    itemClass = "bloqueado-manual";
                    badgeHtml = `
                        <div style="display:flex; flex-direction:column; align-items:flex-end;">
                            <span class="badge badge-bloqueio">${bloqueiosManuais[placaNorm]}</span>
                            <span class="btn-liberar-link" onclick="document.getElementById('blockPlaca').value='${placaNorm}'; alternarBloqueioManual();">[Liberar]</span>
                        </div>`;
                } 
                else if (statusReservado && !liberacoesForçadas.includes(placaNorm)) {
                    itemClass = "indisponivel";
                    badgeHtml = `<span class="badge badge-ocupado">RESERVADO (${stringAgendamento})</span>`;
                } 
                else if (maisDeDozeHoras && !liberacoesForçadas.includes(placaNorm)) {
                    itemClass = "indisponivel";
                    badgeHtml = `
                        <div style="display:flex; flex-direction:column; align-items:flex-end;">
                            <span class="badge badge-ocupado">> 12H DESDE AGEND.</span>
                            <span class="btn-liberar-link btn-liberar-vermelho" onclick="forçarLiberacaoPlaca('${placaNorm}')">[Disponibilizar Carro]</span>
                        </div>`;
                } 
                else {
                    badgeHtml = `<span class="badge badge-livre">Disponível</span>`;
                }

                container.innerHTML += `
                    <div class="frota-item ${itemClass}">
                        <div>
                            <strong>${v.placa}</strong> - ${v.tipo} <span style="color:var(--neon-blue); font-size:0.75rem; font-weight:bold;">(${opNorm})</span><br>
                            <span style="color:#718096; font-size:0.75rem;">${v.motorista}</span>
                        </div>
                        <div style="text-align:right;">
                            ${badgeHtml}
                            <div style="font-family:monospace; color:var(--neon-cyan); font-size:0.75rem; margin-top:4px;">${v.pesoMax}KG | ${v.m3Max}M³ | ${v.palletsMax || 0}PL</div>
                        </div>
                    </div>`;
            });

            // Total é a soma dos próprios contadores (apenas veículos filtrados)
            const totalFiltrado = contDisponivel + contProgramado + contRestrito;

            if (totalFiltrado > 0) {
                document.getElementById('indicadorDisponivel').innerHTML = Math.round((contDisponivel / totalFiltrado) * 100) + "%<br><small>(" + contDisponivel + ")</small>";
                document.getElementById('indicadorProgramado').innerHTML = Math.round((contProgramado / totalFiltrado) * 100) + "%<br><small>(" + contProgramado + ")</small>";
                document.getElementById('indicadorRestrito').innerHTML = Math.round((contRestrito / totalFiltrado) * 100) + "%<br><small>(" + contRestrito + ")</small>";
            } else {
                document.getElementById('indicadorDisponivel').innerHTML = "0%<br><small>(0)</small>";
                document.getElementById('indicadorProgramado').innerHTML = "0%<br><small>(0)</small>";
                document.getElementById('indicadorRestrito').innerHTML = "0%<br><small>(0)</small>";
            }
        }

