                    limitePalletsCaminhao = dados.palletsMax || 0; 
                    
                    document.getElementById('monitorStatus').className = "status-display";
                    document.getElementById('monitorStatus').innerText = `TETO VEÍCULO (${(dados.operacao || 'VENDA').toUpperCase()}): ${limitePesoCaminhao} KG / ${limiteM3Caminhao} M³ / ${limitePalletsCaminhao} PALLETS`;
                    
                    validarRestricoesFormulario();
                }
            });
